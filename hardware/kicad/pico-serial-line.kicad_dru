# Board-specific rules on top of the project's (build_pcb.py).

# The USB-C receptacle's shell (and its silkscreen outline) overhangs the
# back edge on purpose, into the shell's end wall.
(rule "USB-C outline at the edge"
    (condition "A.Parent == 'J1' || B.Parent == 'J1'")
    (constraint silk_clearance (min -2mm)))

# The RJ11's body runs past the front edge, through the shell's end wall.
(rule "RJ11 outline at the edge"
    (condition "A.Parent == 'J2' || B.Parent == 'J2'")
    (constraint silk_clearance (min -2mm)))

# SPEC-L §3.3: across the isolation gap, line side to USB side, 2.5 mm on
# every layer (the gap's rule area keeps tracks, vias and pours out; this
# catches anything else). The RJ11's unused contacts are on the line side:
# they're not counted as USB-side copper.
(rule "Isolation barrier"
    (condition "(A.NetClass == 'Line' && B.NetClass != 'Line' && B.NetName != '' && B.NetName != 'unconnected-*') || (B.NetClass == 'Line' && A.NetClass != 'Line' && A.NetName != '' && A.NetName != 'unconnected-*')")
    (constraint clearance (min 2.5mm)))
