# Board-specific rules on top of the project's (build_pcb.py).

# The DB25's solder-cup pads run to the board edge by design (the board
# slides between the cups); JLCPCB allows copper 0.2 mm from a routed edge.
(rule "DB25 cups reach the edge"
    (condition "A.Parent == 'J2'")
    (constraint edge_clearance (min 0.2mm)))

# The USB-C receptacle's shell (and its silkscreen outline) overhangs the
# back edge on purpose, so its mouth is flush with the hood's cable exit.
(rule "USB-C outline at the edge"
    (condition "A.Parent == 'J1' || B.Parent == 'J1'")
    (constraint silk_clearance (min -2mm)))

# W board only: the hood's thumbscrew pockets narrow the board's front strip
# to +-18 mm, inside the DB25's outline; its silkscreen runs past the edge.
(rule "DB25 outline past the narrow front"
    (condition "A.Parent == 'J2' || B.Parent == 'J2'")
    (layer "F.Silkscreen")
    (constraint silk_clearance (min -2mm))
    (constraint edge_clearance (min -2mm)))
