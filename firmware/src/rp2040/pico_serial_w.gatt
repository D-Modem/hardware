// pico-serial W GATT database (SPEC-W.md 4.2-4.3). Compiled into
// pico_serial_w.h by BTstack's compile_gatt.py at build time.

PRIMARY_SERVICE, GAP_SERVICE
// "pico-serial-XXXX", from the Bluetooth address: served by bt.c
CHARACTERISTIC, GAP_DEVICE_NAME, READ | DYNAMIC,

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_SERVICE_CHANGED, READ,

// Nordic UART Service: the de facto serial-over-BLE, so generic apps work
PRIMARY_SERVICE, 6E400001-B5A3-F393-E0A9-E50E24DCCA9E
// RX: phone -> RS-232
CHARACTERISTIC, 6E400002-B5A3-F393-E0A9-E50E24DCCA9E, DYNAMIC | WRITE | WRITE_WITHOUT_RESPONSE | ENCRYPTION_KEY_SIZE_16,
// TX: RS-232 -> phone
CHARACTERISTIC, 6E400003-B5A3-F393-E0A9-E50E24DCCA9E, DYNAMIC | NOTIFY | ENCRYPTION_KEY_SIZE_16,

// pico-serial control (firmware/PROTOCOL.md "Bluetooth")
PRIMARY_SERVICE, 50530001-5C6F-4E2B-9A6B-1D2C0E5F7A10
// line coding: baud u32, data bits, parity (0 none 1 odd 2 even), stop bits (1, 2)
CHARACTERISTIC, 50530002-5C6F-4E2B-9A6B-1D2C0E5F7A10, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
// outputs: mask, value (PS_LINE_*), as SET_OUTPUTS
CHARACTERISTIC, 50530003-5C6F-4E2B-9A6B-1D2C0E5F7A10, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
// inputs: ps_inputs_t (5 bytes)
CHARACTERISTIC, 50530004-5C6F-4E2B-9A6B-1D2C0E5F7A10, DYNAMIC | READ | NOTIFY | ENCRYPTION_KEY_SIZE_16,
// mode: write the setting (0 auto, 1 DCE, 2 DTE); read setting, role
CHARACTERISTIC, 50530005-5C6F-4E2B-9A6B-1D2C0E5F7A10, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
// break: duration in ms, u16 (0 ends it, 0xFFFF until 0)
CHARACTERISTIC, 50530006-5C6F-4E2B-9A6B-1D2C0E5F7A10, DYNAMIC | WRITE | ENCRYPTION_KEY_SIZE_16,
// flow: 0 auto, 1 on, 2 off
CHARACTERISTIC, 50530007-5C6F-4E2B-9A6B-1D2C0E5F7A10, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
// credits: free bytes in the board's RS-232 transmit buffer, u16
CHARACTERISTIC, 50530008-5C6F-4E2B-9A6B-1D2C0E5F7A10, DYNAMIC | READ | NOTIFY | ENCRYPTION_KEY_SIZE_16,
// info: ps_info_t (14 bytes)
CHARACTERISTIC, 50530009-5C6F-4E2B-9A6B-1D2C0E5F7A10, DYNAMIC | READ | ENCRYPTION_KEY_SIZE_16,
